{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel watch:css dev:vite",
    "dev:vite": "vite",
    "build": "npm-run-all build:css build:vite",
    "build:vite": "vite build",
    "lint": "eslint .",
    "build:css": "cross-env NODE_ENV=production postcss src/assets/styles/app.css -o src/index.css",
    "watch:css": "cross-env NODE_ENV=development postcss src/assets/styles/app.css -o src/index.css --watch",
    "preview": "vite preview"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.11.2",
    "@tailwindcss/typography": "^0.5.19",
    "autoprefixer": "^10.4.24",
    "classnames": "^2.5.1",
    "cross-env": "^10.1.0",
    "cssnano": "^7.1.2",
    "framer-motion": "^12.31.1",
    "history": "^5.3.0",
    "lodash": "^4.17.23",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1",
    "postcss-preset-env": "^11.1.2",
    "prop-types": "^15.8.1",
    "react": "^19.2.0",
    "react-custom-scrollbars": "^4.2.1",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.5.4",
    "react-icons": "^5.5.0",
    "react-modal": "^3.16.3",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.13.0",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
    "tailwind-safelist-generator": "^1.0.0",
    "tailwindcss": "^3.0.7",
    "twin.macro": "^3.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "npm:rolldown-vite@7.2.5"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  }
}
